# ─────────────────────────────────────────────────────────────
# Wilai Communities V3 — คัดลอกเป็น .env.local แล้วเติมค่า
#
# ถ้าไม่ตั้งค่าอะไรเลย แอปจะรันในโหมดสาธิต
# อ่านข้อมูล V2 จาก data/v2-export.json และเก็บผลไว้ที่ data/local-store.json
# ─────────────────────────────────────────────────────────────

# Firebase web config (Project settings → General → Your apps → Web app)
# ค่าพวกนี้ถูกส่งไปกับหน้าเว็บอยู่แล้ว ไม่ใช่ความลับ
# server อ่านตอนรันแล้วส่งให้ client เอง ไม่ได้ฝังตอน build
# ตั้งค่าแล้ว Redeploy ธรรมดาก็เข้าเลย ไม่ต้องล้าง build cache
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# สองตัวนี้ไม่ต้องตั้ง ถ้าไม่ตั้งจะใช้ค่าเริ่มต้นของ Firebase
#   AUTH_DOMAIN     = <projectId>.firebaseapp.com
#   STORAGE_BUCKET  = <projectId>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase ฝั่ง server (Project settings → Service accounts → Generate new private key)
# อันนี้เป็นความลับจริง อย่า commit อย่าส่งให้ใคร
# PRIVATE_KEY วางทั้งก้อนรวมบรรทัด -----BEGIN PRIVATE KEY----- ในเครื่องหมายคำพูด
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# สองตัวนี้ไม่ต้องตั้งก็ได้ ถ้าไม่ตั้งจะใช้ค่าเดียวกับ NEXT_PUBLIC_ ข้างบน
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# กุญแจเซ็นคุกกี้และลิงก์ใบแจ้งหนี้ — ตั้งเป็นค่าสุ่มยาวๆ
AUTH_SECRET=

# ใครล็อกอิน Google สำเร็จก็เข้าได้ในฐานะเจ้าของ ไม่ต้องตั้ง allowlist
# อยากจำกัดเฉพาะบางคนเมื่อไหร่ ตั้ง LOGIN_ALLOWLIST_ONLY=1
# แล้วระบบจะยอมเฉพาะอีเมลใน OWNER_EMAILS หรือใน collection allowlist
LOGIN_ALLOWLIST_ONLY=

# ใช้ตอน LOGIN_ALLOWLIST_ONLY=1 หรือใช้กำหนดว่าใครเป็นเจ้าของ (คั่นด้วยจุลภาค)
OWNER_EMAILS=

# โหมดสาธิตปิดอัตโนมัติเมื่อรันแบบ production เพราะข้อมูลผู้เช่าเป็นข้อมูลจริง
# ตั้งเป็น 1 เฉพาะเมื่อตั้งใจเปิดให้เข้าดูได้โดยไม่ล็อกอิน
ALLOW_DEMO_LOGIN=

# SlipOK — ตรวจสลิปโอนเงิน (ยังไม่ได้ต่อในเวอร์ชันนี้)
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=
RECEIVING_ACCOUNT_LAST4=1085

# LINE Messaging API (ยังไม่ได้ต่อในเวอร์ชันนี้)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

NEXT_PUBLIC_APP_URL=https://wilai.vercel.app
