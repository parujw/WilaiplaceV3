# ─────────────────────────────────────────────────────────────
# Wilai Communities V3 — คัดลอกเป็น .env.local แล้วเติมค่า
#
# ถ้าไม่ตั้งค่าอะไรเลย แอปจะรันในโหมดสาธิต
# อ่านข้อมูล V2 จาก data/v2-export.json และเก็บผลไว้ที่ data/local-store.json
# ─────────────────────────────────────────────────────────────

# Firebase ฝั่ง client (Project settings → Your apps → Web app)
# ค่าพวกนี้ถูกส่งไปกับหน้าเว็บอยู่แล้ว ไม่ใช่ความลับ
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase ฝั่ง server (Project settings → Service accounts → Generate new private key)
# อันนี้เป็นความลับจริง อย่า commit อย่าส่งให้ใคร
# PRIVATE_KEY วางทั้งก้อนรวมบรรทัด -----BEGIN PRIVATE KEY----- ในเครื่องหมายคำพูด
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# สองตัวนี้ไม่ต้องตั้งก็ได้ ถ้าไม่ตั้งจะใช้ค่าเดียวกับ NEXT_PUBLIC_ ข้างบน
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# กุญแจเซ็นคุกกี้โหมดสาธิต — ตั้งเป็นค่าสุ่มยาวๆ
AUTH_SECRET=

# โหมดสาธิตปิดอัตโนมัติเมื่อรันแบบ production เพราะข้อมูลผู้เช่าเป็นข้อมูลจริง
# ตั้งเป็น 1 เฉพาะเมื่อตั้งใจเปิดให้เข้าดูได้โดยไม่ล็อกอิน
ALLOW_DEMO_LOGIN=

# เจ้าของคนแรก เข้าได้ก่อนที่จะมี collection allowlist (คั่นด้วยจุลภาค)
OWNER_EMAILS=

# SlipOK — ตรวจสลิปโอนเงิน (ยังไม่ได้ต่อในเวอร์ชันนี้)
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=
RECEIVING_ACCOUNT_LAST4=1085

# LINE Messaging API (ยังไม่ได้ต่อในเวอร์ชันนี้)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

NEXT_PUBLIC_APP_URL=https://wilai.vercel.app
